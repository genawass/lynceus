{
 "id": "aerial-traffic-strict-v2",
 "version": "2.0",
 "domain": "aerial traffic monitoring; road users only",
 "derivation": "The VisDrone2019-DET published category list and nothing else. Unlike aerial-traffic-v1 this ontology deliberately omits building and tree: the declared annotation target for this deployment is road users, so static scene structure is outside the convention rather than an object the annotator failed to find. Absence of a building annotation is therefore not evidence about buildings. Declared before measurement under assumption A8. Version 2 adds co_occurring: a person rides or is carried by every vehicle class here, so a box around a rider contains two entities rather than one ambiguous entity. Declaring that stops conservative naming from resolving a conflict that does not exist. The class list is unchanged from version 1.",
 "excluded_by_convention": [
  "buildings and architectural structure",
  "vegetation",
  "road surface and markings",
  "street furniture",
  "anything carried or worn"
 ],
