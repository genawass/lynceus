{
  "id": "aerial-traffic-strict-v1",
  "version": "1.0",
  "domain": "aerial traffic monitoring; road users only",
  "derivation": "The VisDrone2019-DET published category list and nothing else. Unlike aerial-traffic-v1 this ontology deliberately omits building and tree: the declared annotation target for this deployment is road users, so static scene structure is outside the convention rather than an object the annotator failed to find. Absence of a building annotation is therefore not evidence about buildings. Declared before measurement under assumption A8.",
  "excluded_by_convention": [
    "buildings and architectural structure",
    "vegetation",
    "road surface and markings",
    "street furniture",
    "anything carried or worn"
  ],
  "classes": [
    {
      "id": "entity",
      "name": "entity",
      "synonyms": [],
      "parent": null,
      "useful": false
    },
    {
